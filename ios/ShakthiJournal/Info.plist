<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Supabase credentials — injected from Secrets.xcconfig at build time.
	     Never hardcode real values here. The $(VAR) syntax pulls from the xcconfig. -->
	<key>SUPABASE_URL</key>
	<string>$(SUPABASE_URL)</string>
	<key>SUPABASE_ANON_KEY</key>
	<string>$(SUPABASE_ANON_KEY)</string>

	<!-- Camera — required for the in-app photo meal logger (food photos,
	     receipts, barcodes). Without this key, iOS hard-crashes the app the
	     moment anything (an <input capture> tap or a getUserMedia() call)
	     touches the camera — it does not show a permission dialog first. -->
	<key>NSCameraUsageDescription</key>
	<string>Jeevan uses your camera so you can snap a photo of a meal, receipt, or barcode and get an instant nutrition estimate.</string>

	<!-- Microphone — required for voice dictation (the mic button in chat,
	     nutrition logging, and workout templates). Same hard-crash rule as
	     the camera above: without this key, getUserMedia({audio:true})
	     kills the app outright instead of prompting. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Jeevan uses your microphone so you can dictate meals, workouts, and messages to your coach instead of typing them.</string>

	<!-- HealthKit read — required, or App Store will reject the binary.
	     Rewritten: the previous text claimed this data is "never shared
	     with anyone," which is false — it syncs to the user's own
	     Supabase account (their own cloud storage, not a third party) and
	     photos/descriptions the user submits may be processed by an AI
	     provider (Groq) to generate estimates. Neither is "sharing" in the
	     sense a user would reasonably read that sentence, but the literal
	     claim of zero data leaving the device was inaccurate and is a real
	     App Review/compliance risk if found. No NSHealthUpdateUsageDescription
	     key anymore — the app doesn't write to HealthKit yet, and Apple
	     review guidance disfavors requesting permission for an
	     unimplemented feature (see HealthKitManager.swift — the matching
	     typesToShare write-authorization request was removed alongside this). -->
	<key>NSHealthShareUsageDescription</key>
	<string>Jeevan reads your health data from Apple Health to sync it to your own personal dashboard and power your AI coach's recommendations. It's stored in your own private account and is never sold or shared with advertisers.</string>

	<!-- Google sign-in redirect — caught by ASWebAuthenticationSession, not app URL
	     handling, but registered here too so the scheme is reserved and documented. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>jeevan.health.fitness</string>
			</array>
		</dict>
	</array>

	<!-- Standard iOS keys -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleDisplayName</key>
	<string>Jeevan</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
